{
  "name": "owlet-editor",
  "version": "0.0.1",
  "description": "Web-based IDE for the BBC Micro",
  "homepage": "https://github.com/mattgodbolt/owlet-editor#readme",
  "bugs": {
    "url": "https://github.com/mattgodbolt/owlet-editor/issues"
  },
  "license": "BSD-2-Clause",
  "author": {
    "name": "Matt Godbolt",
    "email": "matt@godbolt.org",
    "url": "https://xania.org"
  },
  "contributors": [
    {
      "name": "Dominic Pajak",
      "url": "https://www.dompajak.com/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattgodbolt/owlet-editor.git"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "base2048": "^2.0.2",
    "jquery": "^3.7.1",
    "jsbeeb": "2.21.1",
    "monaco-editor": "^0.52.2",
    "promise": "^8.3.0",
    "resize-observer-polyfill": "^1.5.1",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@rollup/plugin-yaml": "^5.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{mjs,js,ts}": [
      "eslint --cache --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{css,md,yaml,json}": [
      "prettier --write"
    ]
  }
}
